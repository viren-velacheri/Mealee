# Copy to .env and fill in. .env is gitignored; never commit real values.

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000
UPLOAD_DIR=./uploads
SQLITE_PATH=./mealee.sqlite
USDA_SQLITE_PATH=../data/usda.sqlite
# Manual meal corrections search FoodData Central. DEMO_KEY works for light local testing;
# use a data.gov key for normal use.
USDA_API_KEY=DEMO_KEY

# Redis Cloud: pub/sub fan-out to phones and arena, plus live fight state.
REDIS_URL=redis://default:CHANGE_ME@CHANGE_ME.db.redis.io:PORT

# MongoDB Atlas: player identity and profile only. Hot game state stays in SQLite.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net
MONGODB_DB=mealee

# Auth0: server-side token verification for player identity.
AUTH0_DOMAIN=dev-c2da7fus6cmejyml.us.auth0.com
AUTH0_CLIENT_ID=CHANGE_ME

# Vision fallback labeller. Skipped automatically if it exceeds VISION_TIMEOUT_S.
IFM_API_KEY=CHANGE_ME
IFM_BASE_URL=https://api.ifm.ai/v1
IFM_MODEL=IFM/K2-Horizon-375B-A23B
VISION_TIMEOUT_S=1.5

# Segmentation weights. yolov8s-seg.pt unless the team fine-tunes.
YOLO_WEIGHTS=yolov8s-seg.pt
